# Copy this file to .env and fill in the values from your Firebase console:
#   Project settings → General → Your apps → Web app (</>) → SDK setup and configuration
#
# Anything prefixed EXPO_PUBLIC_ is inlined into the JavaScript bundle at build
# time, so it ships inside the app and anyone can read it by unpacking the APK.
#
# That is EXPECTED for Firebase web config — these values identify your project,
# they do not authorise anything. Your data is protected by firestore.rules,
# which run on Google's servers. Never put a service account key, an admin
# credential, or any real secret in this file.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
