# dependencies
node_modules/
.pnpm-store

# Expo
.expo/
dist/

# Native folders are generated by `npx expo prebuild` from app.json.
# They are intentionally NOT committed: when they exist in the repo, EAS Build
# ignores app.json for icon, splash, plugins, and permissions, so the two drift
# apart. Let EAS generate them instead — app.json stays the single source of truth.
android/
ios/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local

# Signing secrets — never commit these. Losing the upload keystore means you can
# never update the app under the same Play listing again, so back it up offline.
android/keystore.properties
*.keystore
!android/app/debug.keystore
*.jks
*.p8
*.p12
*.mobileprovision
play-service-account.json

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db
*.apk
*.aab
*.ipa
