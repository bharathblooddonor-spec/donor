rules_version = '2';

// Bharath Blood Donor — Firestore security rules.
//
// Every authorization and validation check happens here, on Google's servers.
// The client SDK is not a security boundary.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function canReadDirectory() {
      return isSignedIn();
    }

    function isValidBloodGroup(value) {
      return value in [
        'O+', 'O-', 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-',
        'A1+', 'A1-', 'A2+', 'A2-', 'A1B+', 'A1B-', 'A2B+', 'A2B-',
        'Bombay Phenotype (Oh+)', 'Bombay Phenotype (Oh-)', 'Rh-null (Golden)'
      ];
    }

    function isValidPhone(value) {
      return value is string && value.matches('^(\\+?91)?[6-9][0-9]{9}$');
    }

    function isValidName(value) {
      return value is string && value.size() >= 2 && value.size() <= 80;
    }

    // ---- users -------------------------------------------------------------
    // Private profile. Only readable and writable by its owner.
    match /users/{uid} {
      allow read, update, delete: if isOwner(uid);
      allow create: if isOwner(uid)
                    && incoming().uid == uid
                    && incoming().email == request.auth.token.email;
    }

    // ---- donors ------------------------------------------------------------
    // One listing per account, document id == uid.
    match /donors/{uid} {
      allow read: if canReadDirectory();

      allow create, update: if (isOwner(uid) || isSignedIn())
                            && incoming().uid == uid
                            && isValidName(incoming().name)
                            && isValidPhone(incoming().phone)
                            && isValidBloodGroup(incoming().bloodGroup)
                            && incoming().age is int
                            && incoming().age >= 18
                            && incoming().age <= 65
                            && incoming().district is string
                            && incoming().district.size() > 0
                            && incoming().isActive is bool;

      allow delete: if isOwner(uid);
    }

    // ---- donations ---------------------------------------------------------
    // Immutable donation logs.
    match /donations/{donationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && incoming().donorId is string;
      allow update, delete: if false;
    }

    // ---- config ------------------------------------------------------------
    // Central system configuration (cooldown settings).
    match /config/{configId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    // ---- requests ----------------------------------------------------------
    // Emergency blood requests.
    match /requests/{requestId} {
      allow read: if canReadDirectory();

      allow create: if isSignedIn()
                    && incoming().uid == request.auth.uid
                    && isValidName(incoming().patientName)
                    && isValidPhone(incoming().phone)
                    && isValidBloodGroup(incoming().bloodGroup)
                    && incoming().hospitalName is string
                    && incoming().hospitalName.size() >= 3
                    && incoming().units is int
                    && incoming().units >= 1
                    && incoming().units <= 20
                    && incoming().fulfilled == false;

      allow update: if (isOwner(resource.data.uid) || isSignedIn())
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasAny(['fulfilled', 'fulfilledAt', 'confirmedDonorId', 'confirmedAt']);

      allow delete: if isOwner(resource.data.uid);
    }

    // ---- reports -----------------------------------------------------------
    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && incoming().listingId is string
                    && incoming().listingType in ['donor', 'request']
                    && incoming().reportedBy == request.auth.uid
                    && incoming().status == 'open';

      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
